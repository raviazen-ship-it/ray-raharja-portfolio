# ==============================================================================
# RAY RAHARJA INTEGRATED PORTFOLIO - CONTOH KONFIGURASI ENVIRONMENT
# Salin berkas ini ke `.env.local` untuk pengembangan lokal.
# JANGAN PERNAH menyimpan password, kunci API, atau secret asli di `.env.example`.
# ==============================================================================

# URL publik kanonik situs (tanpa garis miring di akhir)
NEXT_PUBLIC_SITE_URL=https://ray-raharja-portfolio.vercel.app

# Opsional: Integrasi Supabase (PostgreSQL + Storage + Auth)
# Biarkan kosong apabila menjalankan mode penyimpanan lokal (.data/local-db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Wajib untuk mengaktifkan autentikasi Studio Admin (/admin) di sisi server:
# Gunakan alamat email pemilik dan buat nilai acak minimal 32 karakter untuk secret sesi.
# Contoh pembuatan secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
